{
  "name": "@atelier/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/index.ts src/server.ts --format esm --clean",
    "start": "node dist/server.js",
    "test": "tsx --test src/test/api.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@atelier/contract": "workspace:*",
    "@atelier/database": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.0.2",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.6.0",
    "nodemailer": "^10.1.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@atelier/tsconfig": "workspace:*",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
