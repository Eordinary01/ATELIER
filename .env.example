# ==========================================
# ATELIER COMMERCE ENCLAVE - ENVIRONMENT SPEC
# ==========================================

# Server Environment
NODE_ENV="production"
PORT=4000
HOST="0.0.0.0"

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL="postgres://user:password@hostname:5432/atelier_commerce"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# Cryptographic & Session Secrets (Must be 32+ characters in production)
SESSION_SECRET="your_production_session_jwt_secret_min_32_characters_here"
ADMIN_SESSION_SECRET="your_production_admin_jwt_secret_min_32_characters_here"

# Token Expiry Durations
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS="https://atelier.in,https://admin.atelier.in,http://localhost:3000,http://localhost:3001"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Brevo (Sendinblue) Transactional Emails & Newsletters
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_SENDER_EMAIL="orders@atelier.in"
BREVO_SENDER_NAME="ATELIER Haute Couture"

# Cloudinary CDN Media Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Public URL Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
STOREFRONT_URL="http://localhost:3000"
